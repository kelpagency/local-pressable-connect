{
  "name": "local-pressable-connect",
  "productName": "Pressable Connect",
  "version": "0.1.11",
  "author": "Kelp Agency",
  "keywords": [
    "local-addon",
    "pressable",
    "wordpress",
    "deployment"
  ],
  "bgColor": "#5b2d90",
  "icon": "icon.svg",
  "description": "Push and pull Local WordPress sites to and from Pressable.",
  "renderer": "lib/renderer.js",
  "main": "lib/main.js",
  "files": [
    "lib",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "watch": "npm run build -- --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "node --check lib/main.js && node --check lib/renderer.js && node --check lib/PressableConnect.js"
  },
  "devDependencies": {
    "@getflywheel/eslint-config-local": "1.0.4",
    "@getflywheel/local": "^10.1.1",
    "@types/react": "^18.2.24",
    "@types/ssh2": "^1.15.4",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "eslint": "^8.50.0",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-react": "^7.33.2",
    "typescript": "^4.9.5"
  },
  "peerDependencies": {
    "react": ">=16.4.0",
    "react-dom": ">=16.4.0"
  },
  "dependencies": {
    "fs-extra": "^11.3.2",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.0.1"
  },
  "bundledDependencies": [
    "fs-extra",
    "ssh2",
    "ssh2-sftp-client"
  ],
  "engines": {
    "local-by-flywheel": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelpagency/local-pressable-connect.git"
  },
  "bugs": {
    "url": "https://github.com/kelpagency/local-pressable-connect/issues"
  },
  "homepage": "https://github.com/kelpagency/local-pressable-connect#readme"
}
